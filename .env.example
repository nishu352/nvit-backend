# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5001
HOST=127.0.0.1
NODE_ENV=development

# ─── Supabase PostgreSQL ──────────────────────────────────────────────────────
# HOW TO GET THESE:
# 1. Go to https://supabase.com and create or open your project
# 2. Go to Settings → Database → Connection string
# 3. Copy "URI" mode for DATABASE_URL
# 4. Copy "Direct connection" for DIRECT_URL
#
# DATABASE_URL format (pooled — used at runtime):
#   postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# DIRECT_URL format (direct — used for Prisma migrations only):
#   postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ─── Supabase API Keys ────────────────────────────────────────────────────────
# Get from: Settings → API
# NEVER put these in the frontend / public env files
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
# Use strong random secrets in production (e.g. openssl rand -base64 64)
JWT_SECRET=your-strong-jwt-secret-here
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=your-strong-refresh-secret-here
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Set to your frontend URL in production (e.g. https://yourdomain.com)
CORS_ORIGIN=http://localhost:3000

# ─── AI (Gemini Flash — server-side ONLY) ─────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
# If blank: rule-based column mapping fallback is used automatically
GEMINI_API_KEY=

# ─── SECURITY CHECKLIST ───────────────────────────────────────────────────────
# NEVER put the following in any frontend .env or NEXT_PUBLIC_ variable:
#   DATABASE_URL, DIRECT_URL, SUPABASE_SERVICE_ROLE_KEY, JWT_SECRET,
#   GEMINI_API_KEY, REFRESH_TOKEN_SECRET
